# Copy to .env and adjust. Never commit a real .env.

# --- Database (PostgreSQL + pgvector) ---
POSTGRES_USER=poorvabhas
POSTGRES_PASSWORD=poorvabhas_dev
POSTGRES_DB=poorvabhas
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://poorvabhas:poorvabhas_dev@localhost:5433/poorvabhas

# --- Backend ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
ENVIRONMENT=demo
DEMO_MODE=true
AUTO_SEED=true
SEED_REPORTS=280
MODEL_PATH=./models_store
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

# --- Vector store ---
# auto: use pgvector when the extension is available, else JSON arrays
VECTOR_BACKEND=auto

# --- Optional transformer classifier (requires requirements-transformer.txt + local model) ---
USE_TRANSFORMER=false

# --- Frontend ---
# Browser calls same-origin /api. API_URL is only for standalone local Next.js
# development; Vercel Services routes /api without this proxy.
API_URL=http://localhost:8000

# --- Production: Vercel + Neon (set in Vercel Environment Variables, never in a committed file) ---
# DATABASE_URL        = Neon PostgreSQL connection string (secret; sslmode=require)
# SECRET_KEY          = unique random secret (secret)
# ENVIRONMENT=production   DEMO_MODE=true (synthetic demo)   AUTO_SEED=false
# VECTOR_BACKEND=auto      USE_TRANSFORMER=false            COOKIE_SECURE=true
# CORS_ORIGINS=https://poorvabhas.vercel.app  (inert on Vercel: same-origin)
# NEXT_PUBLIC_API_URL=/api                   API_URL=/api  (proxy disabled on Vercel)
# POSTGRES_* values above are for local Docker Compose only.
# MODEL_PATH defaults to /tmp/poorvabhas-models on Vercel; trained artifacts are
# also persisted in PostgreSQL. Do not point it to a read-only deployment path.
# Existing projects that exceed the standard function package limit may need
# VERCEL_SUPPORT_LARGE_FUNCTIONS=1 in the Vercel dashboard.
