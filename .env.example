# Copy to .env and adjust. Never commit a real .env.

# --- Database (PostgreSQL + pgvector) ---
POSTGRES_USER=poorvabhas
POSTGRES_PASSWORD=poorvabhas_dev
POSTGRES_DB=poorvabhas
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://poorvabhas:poorvabhas_dev@localhost:5433/poorvabhas

# --- Backend ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
ENVIRONMENT=demo
DEMO_MODE=true
AUTO_SEED=true
SEED_REPORTS=280
MODEL_PATH=./models_store
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

# --- Vector store ---
# auto: use pgvector when the extension is available, else JSON arrays
VECTOR_BACKEND=auto

# --- Optional transformer classifier (requires requirements-transformer.txt + local model) ---
USE_TRANSFORMER=false

# --- Frontend ---
# Browser calls same-origin /api; Next.js proxies to API_URL.
NEXT_PUBLIC_API_URL=/api
API_URL=http://localhost:8000
